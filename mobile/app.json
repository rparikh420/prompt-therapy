{
  "expo": {
    "name": "Prompt Therapy",
    "slug": "prompt-therapy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "prompttherapy",
    "backgroundColor": "#0a0a0f",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prompttherapy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.prompttherapy.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3f402ab-730c-44fa-97e5-ec81da486996"
      }
    }
  }
}
